{
  "name": "district-survey",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "yarn build-data && next dev",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "yarn build-data && next build && node scripts/externalize-scripts.mjs out",
    "build-data": "tsx src/lib/config/build-data.ts",
    "build:functions": "node scripts/build-functions.mjs",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "contracts:lint": "spectral lint --fail-severity=warn contracts/openapi/survey-api.v1.yaml contracts/openapi/statistics-api.v1.yaml",
    "contracts:bundle": "redocly bundle contracts/openapi/survey-api.v1.yaml -o dist/contracts/survey-api.v1.yaml && redocly bundle contracts/openapi/statistics-api.v1.yaml -o dist/contracts/statistics-api.v1.yaml",
    "contracts:types": "tsx scripts/generate-contract-types.ts",
    "survey:validate": "tsx scripts/survey-validate.ts",
    "secrets:create": "tsx scripts/create-secrets.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:stack": "tsx scripts/test-stack.ts",
    "test:e2e": "playwright test --project=chromium --project=firefox --project=webkit --project=phone --project=chromium-dark",
    "test:a11y": "PLAYWRIGHT_REPORT_SUFFIX=-a11y playwright test --project=a11y && node scripts/run-pa11y.mjs",
    "test:deployed": "playwright test --config tests/deployed/playwright.config.ts",
    "test:reset": "tsx scripts/reset-test-environment.ts",
    "traceability": "tsx scripts/check-traceability.ts"
  },
  "dependencies": {
    "@lbdistrictscouts/survey-engine": "file:../DistrictWorkflow/packages/survey-engine",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-radio-group": "1.5.1",
    "@radix-ui/react-scroll-area": "1.4.0",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tooltip": "1.4.1",
    "@remixicon/react": "4.9.0",
    "clsx": "2.1.1",
    "next": "16.4.6",
    "next-themes": "0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.1",
    "tailwind-variants": "4.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudwatch": "3.1173.0",
    "@aws-sdk/client-s3": "3.1173.0",
    "@aws-sdk/client-secrets-manager": "3.1173.0",
    "@aws-sdk/client-sqs": "3.1173.0",
    "@aws-sdk/client-ssm": "3.1173.0",
    "@aws-sdk/cloudfront-signer": "3.1172.0",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@redocly/cli": "2.82.0",
    "@stoplight/prism-cli": "5.16.0",
    "@stoplight/spectral-cli": "6.17.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/aws-lambda": "8.10.164",
    "@types/node": "24.19.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "fast-check": "4.10.3",
    "jsdom": "31.0.1",
    "openapi-typescript": "7.13.0",
    "pa11y-ci": "5.0.0",
    "playwright-core": "1.65.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "^5",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "yaml": "2.9.1"
  },
  "packageManager": "yarn@4.18.1"
}
